# Server
SERVER_PORT=8787
DATA_DIR=./data
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8787
DEFAULT_MODEL=xai/grok-4.6
REPLY_DECISION_MODEL=
MAX_CONCURRENT_TURNS=3
CONTEXT_MESSAGES=60
APP_VERSION=

# Security. Required in production. Development may create DATA_DIR/secrets.key.
SECRETS_KEY=

# Authentication. Defaults admit the first account and then invited emails only, and
# print every email link to stdout. AUTH_SECRET defaults to an HKDF-derived value from SECRETS_KEY.
AUTH_SECRET=
# open, code, or invite. Defaults to code when SIGNUP_CODE is set, otherwise invite.
AUTH_SIGNUP=
SIGNUP_CODE=
# Comma-separated additional browser origins trusted by Better Auth. PUBLIC_APP_URL is always
# trusted; outside production, an unset PUBLIC_APP_URL also trusts localhost:3000 and the server port.
AUTH_TRUSTED_ORIGINS=
# Social sign-in. A provider appears on the login page only when both credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Defaults to common when Microsoft credentials are configured.
MICROSOFT_TENANT_ID=common
# SSO providers are configured in Settings → Security. PUBLIC_APP_URL supplies their callback and metadata URLs.
# console, smtp, or resend. EMAIL_FROM is required for smtp and resend.
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_URL=
RESEND_API_KEY=

# Hosted mode. Self-hosters can leave these values empty.
# Entitlement tier; defaults to self-hosted.
WORKSPACE_PLAN=
# Workspace access state; defaults to active.
WORKSPACE_STATE=
# Set to 1 to accept model, Composio, and Computer credentials only from the environment.
MANAGED_KEYS=0
# Composio user id for this workspace; hosted tenants get their slug. Defaults to workspace.
COMPOSIO_USER_ID=
# Member connection ids are derived as <COMPOSIO_USER_ID>:<user id>.
# Bearer secret for the control-plane usage export.
CONTROL_PLANE_TOKEN=
# Optional customer billing portal shown by hosted-mode UI notices.
PUBLIC_BILLING_URL=

# Durable workspace storage. fs uses DATA_DIR/workspace; s3 supports AWS, R2, MinIO, and compatible services.
WORKSPACE_STORE=fs
S3_PROVIDER=other
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=workspace/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0

# Models. Configure at least one, or save one in Settings.
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=

# Optional room-reply experiment, configured in Settings → Experimental. Shadow observes the
# existing model; it never changes replies. The key here is only a fallback for the saved one.
TYPESAFE_API_KEY=
# Deprecated and ignored; use Settings → Experimental.
JEV_REPLY_MODE=
# Synthetic comparison script (pnpm experiment:jev-rooms) only.
JEV_EXPERIMENT_OUTPUT=.context/jev-room-replies.json
JEV_EXPERIMENT_REPEATS=1
JEV_EXPERIMENT_MODEL=jev-latest
JEV_EXPERIMENT_TIMEOUT_MS=1200
JEV_BASELINE_MODEL=

# Bounded browser-action experiment (pnpm experiment:jev-computer) only.
# jev (default, needs TYPESAFE_API_KEY) or mock (deterministic, no network).
JEV_COMPUTER_PROVIDER=jev
JEV_COMPUTER_OUTPUT=.context/jev-computer-use.json
# 1 to 3 passes over the fixture tasks.
JEV_COMPUTER_REPEATS=1
# Per-decision deadline in milliseconds, 200 to 6000.
JEV_COMPUTER_TIMEOUT_MS=2000
# Below this confidence a decision is treated as reobserve. Exploratory, not calibrated.
JEV_COMPUTER_MIN_CONFIDENCE=0.35
# Optional comma-separated fixture task ids; empty runs all of them.
JEV_COMPUTER_TASKS=
# Optional provider/model for the generative comparison arm.
JEV_COMPUTER_BASELINE_MODEL=

# Computer selection. Leave COMPUTER_DRIVER empty to let Settings choose.
COMPUTER_DRIVER=
COMPUTER_IDLE_MINUTES=30
COMPUTER_TAKEOVER_MINUTES=15
COMPUTER_TAKEOVER_WAIT_MS=600000
# Recent image-bearing tool results kept in model context; 0 removes all images.
COMPUTER_SCREENSHOT_CONTEXT=3
COMPUTER_IMAGE=superworkers/computer:local
COMPUTER_WORKSPACE_VOLUME=
COMPUTER_HOME_VOLUME=superworkers-home
COMPUTER_NETWORK=superworkers-default
COMPUTER_CDP_URL=http://superworkers-computer:9222
COMPUTER_DESKTOP_URL=http://superworkers-computer:6901
COMPUTER_VIEWER_PASSWORD=
COMPUTER_CONTROLLER_PASSWORD=
# Empty = probe the sandbox at start and fall back to --no-sandbox if the host cannot run it; 0 = require it; 1 = always disable it.
COMPUTER_CHROME_NO_SANDBOX=
DOCKER_HOST=

# E2B. Configure only when E2B is selected.
E2B_API_KEY=
# Set to 0 for the legacy shell-only base sandbox.
E2B_DESKTOP=1
E2B_DESKTOP_TEMPLATE=desktop
E2B_TEMPLATE=base

# Daytona. Configure only when Daytona is selected.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=

# Freestyle. Configure only when Freestyle is selected.
FREESTYLE_API_KEY=
FREESTYLE_BASE_URL=
FREESTYLE_SNAPSHOT_ID=

# Vercel Sandbox. Configure only when Vercel Sandbox is selected.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_SANDBOX_IMAGE=

# Deployment. PUBLIC_HOST is used by compose.prod.yml for Caddy automatic HTTPS.
PUBLIC_HOST=
OPENSTAFF_VERSION=latest
GHCR_OWNER=superworker-ai
BACKUP_KEEP=7
WORKSPACE_HOST_PATH=

# Opt-in Computer contract tests. Remote suites provision billable sandboxes.
DOCKER_TESTS=0
E2B_TESTS=0
DAYTONA_TESTS=0
FREESTYLE_TESTS=0
VERCEL_TESTS=0
S3_TESTS=0

# Shared app connections and plugins.
COMPOSIO_API_KEY=
PLUGIN_MARKETPLACE_URL=https://raw.githubusercontent.com/cursor/plugins/main/.cursor-plugin/marketplace.json
PLUGIN_MARKETPLACE_REPO=

# Explicit environment allowlists. Prefixes are removed in child processes.
# COMPUTER_ENV_MY_VARIABLE=value
# PLUGIN_ENV_MY_TOKEN=value
