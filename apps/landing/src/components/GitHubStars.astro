---
import { GITHUB_URL } from '../config'
import { formatStars, repoSlug } from '../lib/stars'
import Button from './Button.astro'

// Build-time count so the badge renders without a client round-trip. Any
// failure (private repository, rate limit, offline build, non-repository
// URL) leaves the badge hidden; the client script fills it in later if it can.
const repo = repoSlug(GITHUB_URL)
let stars: number | null = null
if (repo) {
  try {
    const headers: Record<string, string> = { accept: 'application/vnd.github+json' }
    if (process.env.GITHUB_TOKEN) headers.authorization = `Bearer ${process.env.GITHUB_TOKEN}`
    const response = await fetch(`https://api.github.com/repos/${repo}`, { headers, signal: AbortSignal.timeout(3000) })
    if (response.ok) {
      const data = (await response.json()) as { stargazers_count?: number }
      if (typeof data.stargazers_count === 'number') stars = data.stargazers_count
    }
  } catch {
    stars = null
  }
}
---

<Button href={GITHUB_URL} external class="github-button">
  <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
  </svg>
  <span>GitHub</span>
  <span class="stars" data-github-stars={repo ?? undefined} hidden={stars === null}>
    <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
      <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
    </svg>
    <span class="sr-only">stars:</span>
    <span data-count>{stars === null ? '' : formatStars(stars)}</span>
  </span>
</Button>

<script>
  import { formatStars } from '../lib/stars'
  const badges = Array.from(document.querySelectorAll<HTMLElement>('[data-github-stars]'))
  const repo = badges[0]?.dataset.githubStars
  if (repo) {
    fetch(`https://api.github.com/repos/${repo}`, { headers: { accept: 'application/vnd.github+json' } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data: { stargazers_count?: number } | null) => {
        if (typeof data?.stargazers_count !== 'number') return
        for (const badge of badges) {
          const count = badge.querySelector('[data-count]')
          if (count) count.textContent = formatStars(data.stargazers_count)
          badge.hidden = false
        }
      })
      .catch(() => undefined)
  }
</script>

<style>
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.125rem;
    padding-left: 0.625rem;
    border-left: 1px solid rgb(255 255 255 / .25);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    opacity: 0.9;
  }

  .stars[hidden] {
    display: none;
  }
</style>
