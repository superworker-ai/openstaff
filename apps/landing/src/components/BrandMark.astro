---
import horizon from '../assets/horizon.svg?raw'

interface Props {
  size?: number
}

const { size = 28 } = Astro.props
---

<span class="brand-mark" style={{ width: `${size}px`, height: `${size}px` }} aria-hidden="true" set:html={horizon} />

<style>
  .brand-mark { display: inline-flex; flex: none; }
  .brand-mark :global(svg) { display: block; width: 100%; height: 100%; }
</style>
