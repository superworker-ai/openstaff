---
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<div class:list={['container', className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 64rem) {
    .container {
      padding-inline: 2rem;
    }
  }
</style>
