#!/bin/sh
set -eu
umask 077

rm -f /home/worker/.kasmpasswd /tmp/.X1-lock /tmp/.X11-unix/X1
printf '%s\n%s\n' "$COMPUTER_VIEWER_PASSWORD" "$COMPUTER_VIEWER_PASSWORD" \
  | kasmvncpasswd -u viewer -r /home/worker/.kasmpasswd >/dev/null
printf '%s\n%s\n' "$COMPUTER_CONTROLLER_PASSWORD" "$COMPUTER_CONTROLLER_PASSWORD" \
  | kasmvncpasswd -u controller -w /home/worker/.kasmpasswd >/dev/null
chmod 0600 /home/worker/.kasmpasswd
unset COMPUTER_VIEWER_PASSWORD COMPUTER_CONTROLLER_PASSWORD

exec /usr/bin/Xvnc :1 \
  -geometry 1280x800 \
  -depth 24 \
  -interface 0.0.0.0 \
  -websocketPort 6901 \
  -httpd /usr/share/kasmvnc/www
